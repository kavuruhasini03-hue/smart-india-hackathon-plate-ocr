# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Anthropic API key — used for LLM-based sequence correction
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Kaggle credentials — used by scripts/download_data.py
# Get yours at: https://www.kaggle.com/settings (API section)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Roboflow API key — used to download datasets from Roboflow Universe
# Get yours at: https://app.roboflow.com/ (Settings > API Keys)
ROBOFLOW_API_KEY=your_roboflow_api_key

# Optional: Weights & Biases for experiment tracking
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=smart-india-hackathon-plate-ocr
